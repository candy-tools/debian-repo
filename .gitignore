# Built site (generated by `make build`; published by CI). Not committed.
/_site/

# Local GPG signing keyring — PRIVATE, must never be committed.
.gnupg-repo/

# Exported PRIVATE signing key (armored backup) — must never be committed.
*.secret.asc

# Build scratch.
.cache/

# The engine, cloned by the Makefile for local builds.
/.engine/

# Editor / OS cruft.
.DS_Store
*.swp
